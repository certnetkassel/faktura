# env.production.example
# Vorlage für die Produktions-Konfiguration auf dem Server.
# Auf dem Server nach /opt/m365-onboarding/.env kopieren und ausfüllen.
# NIEMALS committen (echte .env steht in .gitignore).

# Hinter nginx: Produktionsmodus (Secure-Cookies). Wird zusätzlich auch in der
# systemd-Unit gesetzt – hier zur Klarheit.
NODE_ENV=production

# App lauscht lokal; nginx leitet onboarding.certnet.eu hierher weiter.
PORT=3000

# Langer Zufallswert, z.B. mit:  openssl rand -hex 32
SESSION_SECRET=

# --- Azure / Entra App-Registration ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Muss exakt der in der App-Registration hinterlegten Redirect-URI entsprechen:
REDIRECT_URI=https://onboarding.certnet.eu/auth/callback
GRAPH_SCOPES=User.ReadWrite.All LicenseAssignment.ReadWrite.All Organization.Read.All User.Read openid profile offline_access

# --- PostgreSQL (lokal auf dem VPS) ---
# Passwort durch ein starkes ersetzen (siehe DEPLOYMENT.md, Schritt PostgreSQL).
DATABASE_URL=postgres://m365:BITTE_STARKES_PASSWORT@localhost:5432/m365onboarding

# --- SMTP (IONOS) ---
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IT-Onboarding <onboarding@certnet.eu>
