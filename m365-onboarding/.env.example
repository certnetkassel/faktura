# .env.example
# Vorlage für die Umgebungskonfiguration. Diese Datei in ".env" kopieren und
# mit echten Werten füllen. Die echte .env NIEMALS committen!

# Port, auf dem der Express-Server lauscht.
PORT=3000

# Geheimer Schlüssel zur Signierung der Session-Cookies (lang und zufällig).
SESSION_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen

# --- Azure / Entra App-Registration ---
# Verzeichnis-(Mandanten-)ID des Tenants.
TENANT_ID=00000000-0000-0000-0000-000000000000
# Anwendungs-(Client-)ID der App-Registration.
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client-Secret der App-Registration.
CLIENT_SECRET=hier-das-client-secret-eintragen
# Redirect-URI, exakt wie in der App-Registration hinterlegt.
REDIRECT_URI=https://onboarding.example.de/auth/callback
# Angeforderte Graph-Scopes (durch Leerzeichen getrennt).
GRAPH_SCOPES=User.ReadWrite.All LicenseAssignment.ReadWrite.All Organization.Read.All User.Read openid profile offline_access

# --- PostgreSQL ---
# Verbindungs-URL zur Datenbank (für Sessions und Audit-Log).
DATABASE_URL=postgres://benutzer:passwort@localhost:5432/m365onboarding

# --- SMTP (IONOS) für den Mailversand ---
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=onboarding@example.de
SMTP_PASS=hier-das-smtp-passwort-eintragen
# Absenderadresse der Willkommensmails.
MAIL_FROM=IT-Onboarding <onboarding@example.de>
